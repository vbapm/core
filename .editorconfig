root = true

[*]
indent_style = tab
end_of_line = lf
insert_final_newline = true
#trim_trailing_whitespace = true

[*.json]
indent_style = space
indent_size = 4

[*.{md,yml}]
indent_style = space
indent_size = 2

[*.{bas,cls,frm,vba,doccls}]
indent_style = space
indent_size = 4
end_of_line = crlf
# Avoid line too long error (https://learn.microsoft.com/en-us/office/vba/language/reference/user-interface-help/line-too-long):
max_line_length = 1023
insert_final_newline = true
trim_trailing_whitespace = true
# Since this project aims at supporting all VBA encodings supported by VBA, we can't specify the
# encoding in the top level editorconfig file.
# We might specify it inside subfolders when it's not easy to detect the encoding of the files
# in that folder. For example, if a folder contains only files with CP1252 encoding, we can specify it there.

