' ------------------------------------------------------------------
' ‘ункци€ расчета заработной платы
' ------------------------------------------------------------------
Function –ассчитать«арплату(оклад As Double, Optional преми€ As Double = 0, Optional вычет As Double = 0) As Double
    ' –асчет заработной платы сотрудника с учетом:
    ' - базового оклада
    ' - ежемес€чной премии
    ' - налогового вычета
    Dim база As Double
    Dim налог As Double
    Dim результат As Double
    ' ѕроверка входных данных
    If оклад <= 0 Then
        –ассчитать«арплату = 0
        Exit Function
    End If
    ' –асчет налогооблагаемой базы
    база = оклад + преми€ - вычет
    ' –асчет подоходного налога
    If база > ћ»Ќ»ћјЋ№Ќќ≈_«Ќј„≈Ќ»≈ Then
        налог = база * ЌјЋќ√ќ¬јя_—“ј¬ ј
    Else
        налог = 0
    End If
    ' »тоговый расчет
    результат = база - налог
    –ассчитать«арплату = результат
End Function

' ------------------------------------------------------------------
' ‘ункци€ форматировани€ даты на русском €зыке
' ------------------------------------------------------------------
Function ‘орматƒаты–ус(дата As Date, Optional полный As Boolean = True) As String
    ' ‘орматирует дату в русском формате
    '
    ' ѕримеры:
    '   01.01.2024 -> "1 €нвар€ 2024 года"
    '   15.03.2024 -> "15 марта 2024"
    '
    ' ѕараметры:
    '   дата   - дата дл€ форматировани€
    '   полный - включать слово "года" (по умолчанию True)
    Dim день As Integer
    Dim мес€ц As Integer
    Dim год As Integer
    Dim названиећес€ца As String
    Dim результат As String
    день = Day(дата)
    мес€ц = Month(дата)
    год = Year(дата)
    ' ќпределение названи€ мес€ца
    Select Case мес€ц
        Case 1:  названиећес€ца = "€нвар€"
        Case 2:  названиећес€ца = "феврал€"
        Case 3:  названиећес€ца = "марта"
        Case 4:  названиећес€ца = "апрел€"
        Case 5:  названиећес€ца = "ма€"
        Case 6:  названиећес€ца = "июн€"
        Case 7:  названиећес€ца = "июл€"
        Case 8:  названиећес€ца = "августа"
        Case 9:  названиећес€ца = "сент€бр€"
        Case 10: названиећес€ца = "окт€бр€"
        Case 11: названиећес€ца = "но€бр€"
        Case 12: названиећес€ца = "декабр€"
    End Select
    ' ‘ормирование результата
    результат = день & " " & названиећес€ца & " " & год
    If полный Then
        результат = результат & " года"
    End If
    ‘орматƒаты–ус = результат
End Function

' ------------------------------------------------------------------
' ‘ункци€ проверки корректности ввода
' ------------------------------------------------------------------
Function ѕроверить¬вод(значение As Variant, Optional тип As String = "число") As Boolean
    ' ѕровер€ет корректность введенного значени€
    '
    ' ѕоддерживаемые типы проверки:
    '   "число"   - положительное целое число
    '   "текст"   - непуста€ строка
    '   "дата"    - корректна€ дата
    '   "телефон" - номер телефона (11 цифр)
    Dim строка As String
    Dim длина As Integer
    Dim i As Integer
    ' ѕроверка на пустое значение
    If IsEmpty(значение) Then
        ѕроверить¬вод = False
        Exit Function
    End If
    Select Case LCase(тип)
        Case "число"
            If Not IsNumeric(значение) Then
                ѕроверить¬вод = False
                Exit Function
            End If
            If CDbl(значение) < 0 Then
                ѕроверить¬вод = False
                Exit Function
            End If
            ѕроверить¬вод = True
        Case "текст"
            строка = CStr(значение)
            If Len(Trim(строка)) = 0 Then
                ѕроверить¬вод = False
                Exit Function
            End If
            ѕроверить¬вод = True
        Case "дата"
            If Not IsDate(значение) Then
                ѕроверить¬вод = False
                Exit Function
            End If
            ѕроверить¬вод = True
        Case "телефон"
            строка = CStr(значение)
            ' ”далить все нецифровые символы
            Dim толькоцифры As String
            толькоцифры = ""
            For i = 1 To Len(строка)
                If Mid(строка, i, 1) Like "[0-9]" Then
                    толькоцифры = толькоцифры & Mid(строка, i, 1)
                End If
            Next i
            ' ѕроверить длину
            If Len(толькоцифры) = 11 Then
                ѕроверить¬вод = True
            Else
                ѕроверить¬вод = False
            End If
        Case Else
            ѕроверить¬вод = False
    End Select
End Function

