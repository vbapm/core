Attribute VB_Name = "RussianExample"
Option Explicit
' Модуль с примерами на русском языке
'
' Этот модуль содержит текст на русском языке для проверки
' определения кодировки CP1251. Все функции являются учебными.
' Глобальные константы для расчетов
Private Const МАКСИМАЛЬНОЕ_ЗНАЧЕНИЕ As Long = 1000000
Private Const МИНИМАЛЬНОЕ_ЗНАЧЕНИЕ As Long = -1000000
Private Const НАЛОГОВАЯ_СТАВКА As Double = 0.2
Private Const КОЛИЧЕСТВО_МЕСЯЦЕВ As Integer = 12

' ------------------------------------------------------------------
' Функция расчета заработной платы
' ------------------------------------------------------------------
Function РассчитатьЗарплату(оклад As Double, Optional премия As Double = 0, Optional вычет As Double = 0) As Double
    ' Расчет заработной платы сотрудника с учетом:
    ' - базового оклада
    ' - ежемесячной премии
    ' - налогового вычета
    Dim база As Double
    Dim налог As Double
    Dim результат As Double
    ' Проверка входных данных
    If оклад <= 0 Then
        РассчитатьЗарплату = 0
        Exit Function
    End If
    ' Расчет налогооблагаемой базы
    база = оклад + премия - вычет
    ' Расчет подоходного налога
    If база > МИНИМАЛЬНОЕ_ЗНАЧЕНИЕ Then
        налог = база * НАЛОГОВАЯ_СТАВКА
    Else
        налог = 0
    End If
    ' Итоговый расчет
    результат = база - налог
    РассчитатьЗарплату = результат
End Function

' ------------------------------------------------------------------
' Функция форматирования даты на русском языке
' ------------------------------------------------------------------
Function ФорматДатыРус(дата As Date, Optional полный As Boolean = True) As String
    ' Форматирует дату в русском формате
    '
    ' Примеры:
    '   01.01.2024 -> "1 января 2024 года"
    '   15.03.2024 -> "15 марта 2024"
    '
    ' Параметры:
    '   дата   - дата для форматирования
    '   полный - включать слово "года" (по умолчанию True)
    Dim день As Integer
    Dim месяц As Integer
    Dim год As Integer
    Dim названиеМесяца As String
    Dim результат As String
    день = Day(дата)
    месяц = Month(дата)
    год = Year(дата)
    ' Определение названия месяца
    Select Case месяц
        Case 1:  названиеМесяца = "января"
        Case 2:  названиеМесяца = "февраля"
        Case 3:  названиеМесяца = "марта"
        Case 4:  названиеМесяца = "апреля"
        Case 5:  названиеМесяца = "мая"
        Case 6:  названиеМесяца = "июня"
        Case 7:  названиеМесяца = "июля"
        Case 8:  названиеМесяца = "августа"
        Case 9:  названиеМесяца = "сентября"
        Case 10: названиеМесяца = "октября"
        Case 11: названиеМесяца = "ноября"
        Case 12: названиеМесяца = "декабря"
    End Select
    ' Формирование результата
    результат = день & " " & названиеМесяца & " " & год
    If полный Then
        результат = результат & " года"
    End If
    ФорматДатыРус = результат
End Function

' ------------------------------------------------------------------
' Функция проверки корректности ввода
' ------------------------------------------------------------------
Function ПроверитьВвод(значение As Variant, Optional тип As String = "число") As Boolean
    ' Проверяет корректность введенного значения
    '
    ' Поддерживаемые типы проверки:
    '   "число"   - положительное целое число
    '   "текст"   - непустая строка
    '   "дата"    - корректная дата
    '   "телефон" - номер телефона (11 цифр)
    Dim строка As String
    Dim длина As Integer
    Dim i As Integer
    ' Проверка на пустое значение
    If IsEmpty(значение) Then
        ПроверитьВвод = False
        Exit Function
    End If
    Select Case LCase(тип)
        Case "число"
            If Not IsNumeric(значение) Then
                ПроверитьВвод = False
                Exit Function
            End If
            If CDbl(значение) < 0 Then
                ПроверитьВвод = False
                Exit Function
            End If
            ПроверитьВвод = True
        Case "текст"
            строка = CStr(значение)
            If Len(Trim(строка)) = 0 Then
                ПроверитьВвод = False
                Exit Function
            End If
            ПроверитьВвод = True
        Case "дата"
            If Not IsDate(значение) Then
                ПроверитьВвод = False
                Exit Function
            End If
            ПроверитьВвод = True
        Case "телефон"
            строка = CStr(значение)
            ' Удалить все нецифровые символы
            Dim толькоцифры As String
            толькоцифры = ""
            For i = 1 To Len(строка)
                If Mid(строка, i, 1) Like "[0-9]" Then
                    толькоцифры = толькоцифры & Mid(строка, i, 1)
                End If
            Next i
            ' Проверить длину
            If Len(толькоцифры) = 11 Then
                ПроверитьВвод = True
            Else
                ПроверитьВвод = False
            End If
        Case Else
            ПроверитьВвод = False
    End Select
End Function

' ------------------------------------------------------------------
' Процедура формирования отчета
' ------------------------------------------------------------------
Sub СформироватьОтчет()
    ' Формирует сводный отчет по продажам за текущий месяц
    ' и сохраняет его в отдельный файл
    Dim листОтчет As Worksheet
    Dim листДанные As Worksheet
    Dim последняяСтрока As Long
    Dim текущаяДата As String
    Dim сообщение As String
    ' Отображение прогресса
    Application.StatusBar = "Формирование отчета, пожалуйста подождите..."
    ' Получить лист с данными
    On Error Resume Next
    Set листДанные = ThisWorkbook.Worksheets("Продажи")
    On Error GoTo 0
    If листДанные Is Nothing Then
        MsgBox "Лист с данными не найден! Обратитесь к администратору.", vbCritical, "Ошибка"
        Exit Sub
    End If
    ' Создать лист для отчета
    Set листОтчет = ThisWorkbook.Worksheets.Add
    листОтчет.Name = "Отчет_" & Format(Date, "YYYYMMDD")
    ' Заголовки отчета
    листОтчет.Cells(1, 1).Value = "Отчет по продажам"
    листОтчет.Cells(2, 1).Value = "Дата формирования:"
    листОтчет.Cells(2, 2).Value = Format(Date, "ДД.ММ.ГГГГ")
    листОтчет.Cells(3, 1).Value = "Подготовил:"
    листОтчет.Cells(3, 2).Value = Environ("USERNAME")
    ' Заголовки таблицы
    листОтчет.Cells(5, 1).Value = "Наименование товара"
    листОтчет.Cells(5, 2).Value = "Количество"
    листОтчет.Cells(5, 3).Value = "Цена за единицу"
    листОтчет.Cells(5, 4).Value = "Общая стоимость"
    листОтчет.Cells(5, 5).Value = "Дата продажи"
    листОтчет.Cells(5, 6).Value = "Покупатель"
    ' Форматирование заголовков
    With листОтчет.Range("A5:F5")
        .Font.Bold = True
        .Interior.Color = RGB(200, 220, 255)
        .Borders.LineStyle = xlContinuous
    End With
    Application.StatusBar = False
    сообщение = "Отчет успешно сформирован!" & vbCrLf & _
                "Проверьте лист: " & листОтчет.Name
    MsgBox сообщение, vbInformation, "Готово"
End Sub

