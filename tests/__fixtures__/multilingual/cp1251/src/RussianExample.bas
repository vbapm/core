Function ПолучитьНазваниеМесяца(номер As Integer) As String
    Dim названия As Variant
    названия = Array("январь", "февраль", "март", "апрель", "май", "июнь", "июль", "август", "сентябрь", "октябрь", "ноябрь", "декабрь")
    If номер >= 1 And номер <= 12 Then
        ПолучитьНазваниеМесяца = названия(номер - 1)
    Else
        ПолучитьНазваниеМесяца = "неизвестный месяц"
    End If
End Function

Function ПроверитьДоступ(пользователь As String, пароль As String) As Boolean
    Dim разрешенныеПользователи As Variant
    разрешенныеПользователи = Array("администратор", "менеджер", "оператор")
    Dim i As Integer
    For i = 0 To UBound(разрешенныеПользователи)
        If LCase(пользователь) = разрешенныеПользователи(i) Then
            ПроверитьДоступ = True
            Exit Function
        End If
    Next i
    ПроверитьДоступ = False
End Function

Sub ПоказатьСправку()
    Dim текстСправки As String
