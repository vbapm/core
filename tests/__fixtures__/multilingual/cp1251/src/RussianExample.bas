    текстСправки = текстСправки & "Для начала работы выберите нужный раздел меню." & vbCrLf
    текстСправки = текстСправки & "При возникновении вопросов обратитесь к администратору."
    MsgBox текстСправки, vbInformation, "Справка"
End Sub
